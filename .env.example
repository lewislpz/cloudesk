# Runtime identity
APP_ENV=development
API_HTTP_ADDRESS=:8080
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=15s
API_IDLE_TIMEOUT=60s
API_REQUEST_TIMEOUT=10s
API_SHUTDOWN_TIMEOUT=30s
WORKER_SHUTDOWN_TIMEOUT=60s
WEB_HTTP_PORT=3000

# Same-origin browser and server-to-server API locations
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
API_INTERNAL_ORIGIN=http://localhost:8080

# Local dependency endpoints. These public fixture credentials are deliberately
# invalid for staging/production; override them only in ignored local config.
DATABASE_URL=postgres://clouddesk_local:clouddesk-local-only@localhost:5432/clouddesk?sslmode=disable
OIDC_ISSUER_URL=http://localhost:5556/dex
OIDC_CLIENT_ID=clouddesk-local
OIDC_CLIENT_SECRET=clouddesk-local-only

# Application-session material; generate local values outside version control
SESSION_HASH_KEY=
SESSION_ENCRYPTION_KEY=
